name: ci

on:
  push:
    paths:
      - "cmd/**"
      - "internal/**"
      - "go.mod"
      - "go.sum"
      - ".github/workflows/ci.yml"
    branches: [main]
  pull_request:
    paths:
      - "cmd/**"
      - "internal/**"
      - "go.mod"
      - "go.sum"
      - ".github/workflows/ci.yml"

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          version-file: go.mod
          cache: true
      - run: go test ./...
      - run: go vet ./...
      - run: go build -o /tmp/{{.Name}} ./cmd/{{.Name}}
